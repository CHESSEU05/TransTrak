{
  "expo": {
    "name": "TransTrak",
    "slug": "TransTrak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/transtrak-mark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/icons/transtrak-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TransTrak to find nearby taxis and bikes and track active trips."
        }
      ],
      "expo-font",
      "expo-notifications"
    ]
  }
}
