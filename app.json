{
  "expo": {
    "name": "TransTrak",
    "slug": "TransTrak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/transtrak-mark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/icons/transtrak-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.tertul_lien.TransTrak"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TransTrak to find nearby taxis and bikes and track active trips."
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "9591eea6-a0e5-4ce2-8d00-b8f6a70008e9"
      }
    },
    "owner": "tertul_lien",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9591eea6-a0e5-4ce2-8d00-b8f6a70008e9"
    }
  }
}
